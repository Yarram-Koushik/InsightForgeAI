# LLM API Keys (Free tiers)
GROQ_API_KEY=your_groq_key_here
GOOGLE_API_KEY=your_gemini_key_here

# App Settings
APP_ENV=development
APP_NAME=InsightForgeAI

# Phase 3.5 – API Auth
# Leave EMPTY for open local dev (no key required).
# To ENABLE auth, set at least one key, then RESTART the API:
#   Format: key_id:role:secret
#   Roles: viewer | analyst | admin
# Example (copy the secret into X-API-Key header):
# INSIGHTFORGE_API_KEYS=admin1:admin:sk-test-123,viewer1:viewer:sk-view-456
INSIGHTFORGE_API_KEYS=

# Phase 3.7 – Rate limiting
RATE_LIMIT_PER_SEC=5
RATE_LIMIT_BURST=20

# Optional: UI → API URL inside Docker network
INSIGHTFORGE_API_URL=http://api:8000

# Durable workspace id used by Streamlit restore (Phase 3.3)
INSIGHTFORGE_WORKSPACE_ID=default
