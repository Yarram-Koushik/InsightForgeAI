# LLM API Keys (Free tiers)
GROQ_API_KEY=your_groq_key_here
GOOGLE_API_KEY=your_gemini_key_here

# App Settings
APP_ENV=development
APP_NAME=InsightForgeAI

# Phase 3.5 – API Auth
# Leave EMPTY for open local dev (no key required).
# To ENABLE auth, set at least one key, then RESTART the API:
#   Format: key_id:role:secret
#   Roles: viewer | analyst | admin
# Example (copy the secret into X-API-Key header):
# INSIGHTFORGE_API_KEYS=admin1:admin:sk-test-123,viewer1:viewer:sk-view-456
INSIGHTFORGE_API_KEYS=

# Phase 3.7 – Rate limiting
RATE_LIMIT_PER_SEC=5
RATE_LIMIT_BURST=20

# Optional: UI → API URL inside Docker network
INSIGHTFORGE_API_URL=http://api:8000

# Durable workspace id used by Streamlit restore (Phase 3.3)
INSIGHTFORGE_WORKSPACE_ID=default
# ---------------------------------------------------------------------------
# Phase 4.1 – Live Data Connectors (optional)
# Prefer URLs for demos. Never commit real secrets.
# ---------------------------------------------------------------------------
# PostgreSQL
# POSTGRES_URL=postgresql://user:password@host:5432/dbname
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=mydb
# POSTGRES_USER=readonly_user
# POSTGRES_PASSWORD=
# POSTGRES_SSLMODE=prefer

# MySQL / MariaDB
# MYSQL_URL=mysql://user:password@host:3306/dbname
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DB=mydb
# MYSQL_USER=readonly_user
# MYSQL_PASSWORD=

# Set to 1 to enable live connector tests in CI / local
# INSIGHTFORGE_LIVE_DB=0

# ---------------------------------------------------------------------------
# Phase 4.5 – Scheduling & delivery
# ---------------------------------------------------------------------------
# In-process due-schedule poller (1=on, 0=off)
INSIGHTFORGE_SCHEDULER=1
SCHEDULER_POLL_SEC=60

# Slack Incoming Webhook (optional; per-schedule webhook_url can override)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# SMTP for email reports (optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=insightforge@example.com
# SMTP_TLS=1
# REPORT_EMAIL_TO=team@example.com
